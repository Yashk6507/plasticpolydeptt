PORT=5000
NODE_ENV=development

# JWT Secret (change this in production)
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d

# Maximum upload size per image, in bytes (default 5 MB)
MAX_FILE_SIZE=5242880

# Optional: point the JSON store somewhere else (used by the test suite)
# DATA_FILE=./data/store.json

# ==================================================================
# NOTIFICATION GATEWAYS
#
# SMS is deliberately OFF (SMS_PROVIDER=none) — email only, as requested.
# ==================================================================

# ------------------------------------------------------------------
# EMAIL — Brevo HTTP API
# Setting BREVO_API_KEY automatically selects Brevo; no SMTP values needed.
# MAIL_FROM must be a sender address verified in your Brevo account.
# ------------------------------------------------------------------
BREVO_API_KEY=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
BREVO_API_BASE_URL=https://api.brevo.com
MAIL_FROM=Plastic Polymer Testing Department <plasticpolydepartment@gmail.com>
SMTP_TIMEOUT_MS=10000

# ------------------------------------------------------------------
# EMAIL — SMTP alternative (unused while BREVO_API_KEY is set)
# ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ------------------------------------------------------------------
# SMS — disabled. No SMS is ever attempted while this is "none".
# To enable later: set twilio or fast2sms and fill in that block below.
# ------------------------------------------------------------------
SMS_PROVIDER=none
SMS_SENDER_ID=
SMS_TIMEOUT_MS=10000

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_API_BASE_URL=https://api.twilio.com

# Fast2SMS (India, https://www.fast2sms.com)
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q
FAST2SMS_API_BASE_URL=https://www.fast2sms.com
